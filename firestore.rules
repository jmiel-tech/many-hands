rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function uid() {
      return request.auth.uid;
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }
    function isText(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }
    function hasExactly(fields) {
      return incoming().keys().hasAll(fields) && incoming().keys().hasOnly(fields);
    }
    function unchanged(field) {
      return incoming()[field] == existing()[field];
    }
    function createdNow() {
      return incoming().createdAt == request.time;
    }
    function memberExists(id) {
      return exists(/databases/$(database)/documents/members/$(id));
    }

    // ---- members/{uid} ----
    function validMember() {
      return hasExactly(['name', 'email', 'phone', 'createdAt'])
        && isText(incoming().name, 1, 80)
        && isText(incoming().email, 3, 254)
        && isText(incoming().phone, 1, 30);
    }

    match /members/{memberId} {
      allow read: if signedIn();
      // The email on a profile always has to be the member's real login email.
      allow create: if signedIn() && memberId == uid() && validMember() && createdNow()
        && incoming().email == request.auth.token.email;
      allow update: if signedIn() && memberId == uid() && validMember() && unchanged('createdAt')
        && (unchanged('email') || incoming().email == request.auth.token.email);
      allow delete: if signedIn() && memberId == uid();
    }

    // ---- issues/{id} ----
    // Everyone can read. editorIds lists who can edit the issue and create tasks on it; the owner is always in it.
    function validIssue() {
      return hasExactly(['title', 'description', 'status', 'ownerId', 'editorIds', 'createdAt'])
        && isText(incoming().title, 1, 120)
        && isText(incoming().description, 0, 2000)
        && incoming().status in ['open', 'in_progress', 'resolved']
        && incoming().editorIds is list
        && incoming().editorIds.size() <= 100
        && incoming().ownerId in incoming().editorIds;
    }
    // Editors who aren't the owner can only change the issue's content.
    function isContentEdit() {
      return incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'status']);
    }

    match /issues/{issueId} {
      allow read: if signedIn();
      allow create: if signedIn() && validIssue() && createdNow() && incoming().ownerId == uid();
      allow update: if signedIn() && validIssue() && unchanged('ownerId') && unchanged('createdAt')
        && (existing().ownerId == uid()
            || (uid() in existing().editorIds && isContentEdit()));
      allow delete: if signedIn() && existing().ownerId == uid();
    }

    // ---- tasks/{id} ----
    function validTask() {
      return hasExactly(['issueId', 'title', 'description', 'status', 'assigneeId', 'createdBy', 'createdAt'])
        && incoming().issueId is string
        && isText(incoming().title, 1, 120)
        && isText(incoming().description, 0, 2000)
        && incoming().status in ['todo', 'doing', 'done']
        && (incoming().assigneeId == null
            || (incoming().assigneeId is string && memberExists(incoming().assigneeId)));
    }
    // Claim: an unassigned task, taken by the signed-in user, with nothing else touched.
    function isClaim() {
      return existing().assigneeId == null
        && incoming().assigneeId == uid()
        && incoming().diff(existing()).affectedKeys().hasOnly(['assigneeId']);
    }

    match /tasks/{taskId} {
      allow read: if signedIn();
      allow create: if signedIn() && validTask() && createdNow()
        && incoming().createdBy == uid()
        && uid() in get(/databases/$(database)/documents/issues/$(incoming().issueId)).data.editorIds;
      allow update: if signedIn() && (
        isClaim()
        || (existing().assigneeId == uid() && validTask()
            && unchanged('issueId') && unchanged('createdBy') && unchanged('createdAt'))
      );
      allow delete: if signedIn() && existing().assigneeId == uid();
    }

    // ---- comments/{id} ----
    function validComment() {
      return hasExactly(['taskId', 'authorId', 'text', 'createdAt'])
        && incoming().taskId is string
        && isText(incoming().text, 1, 2000);
    }

    match /comments/{commentId} {
      allow read: if signedIn();
      allow create: if signedIn() && validComment() && createdNow()
        && incoming().authorId == uid()
        && exists(/databases/$(database)/documents/tasks/$(incoming().taskId));
      allow update: if signedIn() && existing().authorId == uid() && validComment()
        && unchanged('taskId') && unchanged('authorId') && unchanged('createdAt');
      allow delete: if signedIn() && existing().authorId == uid();
    }
  }
}
