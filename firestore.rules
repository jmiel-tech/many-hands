rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function uid() {
      return request.auth.uid;
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }
    function isText(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }
    function hasExactly(fields) {
      return incoming().keys().hasAll(fields) && incoming().keys().hasOnly(fields);
    }
    function unchanged(field) {
      return incoming()[field] == existing()[field];
    }
    function createdNow() {
      return incoming().createdAt == request.time;
    }
    function memberExists(id) {
      return exists(/databases/$(database)/documents/members/$(id));
    }
    function adminId(id) {
      return exists(/databases/$(database)/documents/admins/$(id));
    }
    function bannedId(id) {
      return exists(/databases/$(database)/documents/bans/$(id));
    }
    // Signed in and not removed by an admin. Every shared read and write goes through this.
    function active() {
      return signedIn() && !bannedId(uid());
    }
    function isAdmin() {
      return active() && adminId(uid());
    }

    // ---- admins/{uid} ----
    // Admins are added and removed in the Firebase console only, never from the app.
    match /admins/{adminUid} {
      allow read: if active();
      allow write: if false;
    }

    // ---- bans/{uid} ----
    // A ban removes someone from the community. Their login still exists, but every rule below refuses them.
    match /bans/{bannedUid} {
      // The removed person can read their own ban, so the app can tell them what happened.
      allow read: if isAdmin() || (signedIn() && bannedUid == uid());
      allow create: if isAdmin() && bannedUid != uid() && !adminId(bannedUid)
        && hasExactly(['name', 'email', 'bannedBy', 'createdAt'])
        && isText(incoming().name, 0, 80)
        && isText(incoming().email, 0, 254)
        && incoming().bannedBy == uid()
        && createdNow();
      allow delete: if isAdmin();
      allow update: if false;
    }

    // ---- members/{uid} ----
    function validMember() {
      return hasExactly(['name', 'email', 'phone', 'createdAt'])
        && isText(incoming().name, 1, 80)
        && isText(incoming().email, 3, 254)
        && isText(incoming().phone, 1, 30);
    }

    match /members/{memberId} {
      allow read: if active();
      // The email on a profile always has to be the member's real login email.
      allow create: if active() && memberId == uid() && validMember() && createdNow()
        && incoming().email == request.auth.token.email;
      allow update: if active() && memberId == uid() && validMember() && unchanged('createdAt')
        && (unchanged('email') || incoming().email == request.auth.token.email);
      // An admin removing someone deletes their profile. Admins can't remove each other.
      allow delete: if active() && (memberId == uid() || (isAdmin() && !adminId(memberId)));
    }

    // ---- issues/{id} ----
    function validIssue() {
      return hasExactly(['title', 'description', 'status', 'ownerId', 'createdAt'])
        && isText(incoming().title, 1, 120)
        && isText(incoming().description, 0, 2000)
        && incoming().status in ['open', 'in_progress', 'resolved'];
    }

    match /issues/{issueId} {
      allow read: if active();
      allow create: if active() && validIssue() && createdNow() && incoming().ownerId == uid();
      allow update: if active() && (existing().ownerId == uid() || isAdmin()) && validIssue()
        && unchanged('ownerId') && unchanged('createdAt');
      allow delete: if active() && (existing().ownerId == uid() || isAdmin());
    }

    // ---- tasks/{id} ----
    function validTask() {
      return hasExactly(['issueId', 'title', 'description', 'status', 'assigneeId', 'createdBy', 'createdAt'])
        && incoming().issueId is string
        && isText(incoming().title, 1, 120)
        && isText(incoming().description, 0, 2000)
        && incoming().status in ['todo', 'doing', 'done']
        && (incoming().assigneeId == null
            || (incoming().assigneeId is string && memberExists(incoming().assigneeId)));
    }
    // Claim: an unassigned task, taken by the signed-in user, with nothing else touched.
    function isClaim() {
      return existing().assigneeId == null
        && incoming().assigneeId == uid()
        && incoming().diff(existing()).affectedKeys().hasOnly(['assigneeId']);
    }
    // Admin release: frees a task held by someone being removed, so it goes back to Unclaimed.
    function isAdminRelease() {
      return isAdmin()
        && incoming().assigneeId == null
        && incoming().diff(existing()).affectedKeys().hasOnly(['assigneeId']);
    }

    match /tasks/{taskId} {
      allow read: if active();
      allow create: if active() && validTask() && createdNow()
        && incoming().createdBy == uid()
        && exists(/databases/$(database)/documents/issues/$(incoming().issueId));
      allow update: if active() && (
        isClaim()
        || isAdminRelease()
        || (existing().assigneeId == uid() && validTask()
            && unchanged('issueId') && unchanged('createdBy') && unchanged('createdAt'))
      );
      // Admins can delete tasks so they can delete an issue together with its tasks.
      allow delete: if active() && (existing().assigneeId == uid() || isAdmin());
    }

    // ---- comments/{id} ----
    function validComment() {
      return hasExactly(['taskId', 'authorId', 'text', 'createdAt'])
        && incoming().taskId is string
        && isText(incoming().text, 1, 2000);
    }

    match /comments/{commentId} {
      allow read: if active();
      allow create: if active() && validComment() && createdNow()
        && incoming().authorId == uid()
        && exists(/databases/$(database)/documents/tasks/$(incoming().taskId));
      allow update: if active() && existing().authorId == uid() && validComment()
        && unchanged('taskId') && unchanged('authorId') && unchanged('createdAt');
      allow delete: if active() && existing().authorId == uid();
    }
  }
}
